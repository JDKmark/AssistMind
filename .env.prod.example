# AssistMind 线上部署环境变量模板
# 部署脚本 deploy/deploy.sh 会自动复制为 .env.prod 并补全密钥（.env.prod 已被 gitignore，勿提交）。
# 手工部署：cp .env.prod.example .env.prod 后填写。

# ===== 必填 =====
# DeepSeek API Key（线上演示主 LLM；申请 https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 生产安全密钥（部署脚本自动生成 64 位随机 hex；手工部署请换随机值）
JWT_SECRET=

# ===== 容器内服务地址（compose overlay 已按服务名互通，一般无需改）=====
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/assistmind
PROMETHEUS_URL=http://prometheus:9090

# ===== 数据源模式 =====
# auto：健康探测通过用真实数据源，否则降级 mock（与项目失败降级哲学一致）
MALL_DATA_SOURCE=auto
OPS_DATA_SOURCE=auto

# ===== 首次启动自动灌知识库（Qdrant 集合非空则跳过，秒起）=====
AUTO_SEED_KB=true

# ===== 可选 =====
# 限流（按客户端 IP 固定窗口，Redis 兜底放行）
# RATE_LIMIT_PER_MINUTE=60
# 向量集合名（与灌库脚本一致，默认 assistmind_docs）
# QDRANT_COLLECTION=assistmind_docs
# Embedding / Reranker 模型（离线体积较大，默认即可）
# EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
