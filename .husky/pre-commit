#!/usr/bin/env sh
# pre-commit：只对暂存文件做 lint/format，保证提交速度（全量测试见 pre-push 与 CI）。
# 注意：本文件必须是 POSIX sh，不要混入 PowerShell 语法（$LASTEXITCODE、if (...)）。
set -e

if [ ! -d node_modules/lint-staged ]; then
  echo "[pre-commit] 未安装仓库级 devDependencies，跳过 lint-staged"
  echo "[pre-commit] 首次使用请在仓库根目录执行：npm install"
  exit 0
fi

echo "[pre-commit] lint-staged（ESLint + Prettier，仅暂存文件）"
npx --no-install lint-staged
