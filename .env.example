# ===== 应用配置 =====
APP_NAME=AssistMind
DEBUG=true
JWT_SECRET=changeme-in-production-please-use-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== LLM 配置 =====
# 主：DeepSeek API
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备：Ollama 本地
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== Embedding & Reranker =====
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# ===== Qdrant 向量库 =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=assistmind_docs
QDRANT_API_KEY=

# ===== Redis 缓存 =====
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
SEMANTIC_CACHE_SIMILARITY=0.92
SEMANTIC_CACHE_MAX_ENTRIES=10000

# ===== PostgreSQL 元数据库 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=assistmind

# ===== RAG 参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64
VECTOR_TOP_K=40
BM25_TOP_K=40
RERANK_TOP_K=8
RRF_K=60
JACCARD_DEDUP_THRESHOLD=0.8
CRAG_HIGH_THRESHOLD=0.7
CRAG_LOW_THRESHOLD=0.3

# ===== 查询改写（Multi-Query / HyDE）=====
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_STRATEGY=multi_query
QUERY_REWRITE_NUM_VARIANTS=3

# ===== 失败降级（指数退避 + 断路器 + 独立超时）=====
FALLBACK_ENABLED=true
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_JITTER=0.5
LLM_FALLBACK_PROVIDER=ollama

# 超时（秒）
LLM_TIMEOUT=30
LLM_FALLBACK_TIMEOUT=15
EMBEDDING_TIMEOUT=10
QDRANT_TIMEOUT=5
BM25_TIMEOUT=5
RERANKER_TIMEOUT=15
REDIS_TIMEOUT=2
POSTGRES_TIMEOUT=5
QUERY_REWRITE_TIMEOUT=10
CRAG_TIMEOUT=10

# 断路器（失败次数阈值 / Open 持续秒 / Half-Open 探测次数）
CB_LLM_FAIL_THRESHOLD=5
CB_LLM_OPEN_SECONDS=60
CB_LLM_HALF_OPEN_PROBES=3
CB_EMBEDDING_FAIL_THRESHOLD=3
CB_EMBEDDING_OPEN_SECONDS=30
CB_QDRANT_FAIL_THRESHOLD=5
CB_QDRANT_OPEN_SECONDS=60
CB_RERANKER_FAIL_THRESHOLD=3
CB_REDIS_FAIL_THRESHOLD=5
CB_REDIS_OPEN_SECONDS=30
CB_POSTGRES_FAIL_THRESHOLD=5

# ===== 意图路由（faq/task/chat/unclear）=====
INTENT_SEMANTIC_THRESHOLD=0.85
INTENT_SEMANTIC_MARGIN=0.1

# ===== 对话记忆 =====
MEMORY_WINDOW=10
MEMORY_SUMMARY_THRESHOLD=6

# ===== MCP（Model Context Protocol）=====
MCP_SERVER_ENABLED=true
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_TRANSPORT=streamable_http

# ===== Langfuse 可观测 =====
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 限流 =====
RATE_LIMIT_PER_MINUTE=60

# ===== 工单 =====
TICKET_ID_RANDOM_SUFFIX=7

# ===== 运维数据源（Prometheus / ELK）=====
# auto: 配置了 PROMETHEUS_URL 用真实数据源，未配置/整体不可用降级 mock
# mock: 恒用预置故障场景模拟数据
# real: 恒用真实数据源（单源失败走各方法降级 + degraded 标记）
OPS_DATA_SOURCE=auto
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10
PROMETHEUS_SERVICE_LABEL=service
ALERTMANAGER_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=logs-*
ELASTICSEARCH_CHANGE_INDEX=changes-*
ELASTICSEARCH_TIMEOUT=10

# 运维数据源断路器
CB_PROMETHEUS_FAIL_THRESHOLD=5
CB_PROMETHEUS_OPEN_SECONDS=60
CB_ELASTICSEARCH_FAIL_THRESHOLD=5
CB_ELASTICSEARCH_OPEN_SECONDS=60
CB_ALERTMANAGER_FAIL_THRESHOLD=3
CB_ALERTMANAGER_OPEN_SECONDS=60

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
