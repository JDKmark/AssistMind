APP_NAME=AssistMind
DEBUG=true
JWT_SECRET=changeme-in-production-please-use-strong-secret
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding & Reranker
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# Qdrant / Redis / PostgreSQL
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=assistmind_docs
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistmind
# DDL/回填/授权专用迁移账号（phase13 最小权限）：留空回退 DATABASE_URL（本地开发单账号）；
# 生产必须配置独立迁移账号（deploy.sh 与容器入口会校验账号分离，见 .env.prod.example）
DATABASE_MIGRATION_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 语音播报（TTS）：edge-tts 云端神经音色（免费无 key），晓晓女声；可切 zh-CN-YunxiNeural（男声）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# MCP（Model Context Protocol）
MCP_SERVER_ENABLED=true
# 尾斜杠必须保留：/mcp 无尾斜杠会被 FastAPI mount 307 重定向，MCP 客户端不跟随导致连接失败
# 后端实际监听端口必须与 MCP_SERVER_URL 一致（进程内 MCP 客户端同端口握手）
MCP_SERVER_URL=http://localhost:8002/mcp/
MCP_TRANSPORT=streamable_http

# 失败降级（指数退避 + 断路器 + 独立超时）
FALLBACK_ENABLED=true
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_JITTER=0.5
LLM_FALLBACK_PROVIDER=ollama

# 超时（秒）
LLM_TIMEOUT=30
LLM_FALLBACK_TIMEOUT=15
EMBEDDING_TIMEOUT=10
QDRANT_TIMEOUT=5
BM25_TIMEOUT=5
RERANKER_TIMEOUT=15
REDIS_TIMEOUT=2
POSTGRES_TIMEOUT=5
QUERY_REWRITE_TIMEOUT=10
CRAG_TIMEOUT=10

# 断路器
CB_LLM_FAIL_THRESHOLD=5
CB_LLM_OPEN_SECONDS=60
CB_LLM_HALF_OPEN_PROBES=3
CB_EMBEDDING_FAIL_THRESHOLD=3
CB_EMBEDDING_OPEN_SECONDS=30
CB_QDRANT_FAIL_THRESHOLD=5
CB_QDRANT_OPEN_SECONDS=60
CB_RERANKER_FAIL_THRESHOLD=3
CB_REDIS_FAIL_THRESHOLD=5
CB_REDIS_OPEN_SECONDS=30
CB_POSTGRES_FAIL_THRESHOLD=5

# 查询改写
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_STRATEGY=multi_query
QUERY_REWRITE_NUM_VARIANTS=3

# ===== 应用级可观测（T5）：GET /metrics（Prometheus exporter）=====
# 单进程指标有效；多 worker 部署需 multiprocess 模式（见 docs/perf-baseline-*.md）
METRICS_ENABLED=true

# ===== 故障注入（T6，压测用；默认全关，运行时可热切换，无需重启）=====
# FAULT_LLM=ok|timeout|error|slow
# FAULT_RERANKER=ok|timeout|fail
# FAULT_QDRANT=ok|down
FAULT_LLM=ok
FAULT_RERANKER=ok
FAULT_QDRANT=ok
# 运行时覆盖文件（可选）：JSON 如 {"FAULT_RERANKER": "fail"}，按 mtime 热加载，
# 压测中改写该文件即可开关故障、关闭后自动恢复，无需重启进程；留空只用上面的变量
FAULT_OVERRIDE_FILE=

# ===== Mock LLM 模式（离线压测：LLM_PROVIDER=mock）=====
MOCK_LLM_TOKENS=300
MOCK_LLM_INTERVAL_MS=20

# ===== 限流兜底（T8）：off（默认，fail-open 不变）| inproc（进程内兜底，仅单实例）=====
RATE_LIMIT_FALLBACK=off

# 运维数据源（Prometheus / ELK）——auto: 配置了 PROMETHEUS_URL 用真实数据源，否则 mock
OPS_DATA_SOURCE=auto
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10
PROMETHEUS_SERVICE_LABEL=service
ALERTMANAGER_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=logs-*
ELASTICSEARCH_CHANGE_INDEX=changes-*
ELASTICSEARCH_TIMEOUT=10
CB_PROMETHEUS_FAIL_THRESHOLD=5
CB_PROMETHEUS_OPEN_SECONDS=60
CB_ELASTICSEARCH_FAIL_THRESHOLD=5
CB_ELASTICSEARCH_OPEN_SECONDS=60
CB_ALERTMANAGER_FAIL_THRESHOLD=3
CB_ALERTMANAGER_OPEN_SECONDS=60
